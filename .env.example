# Izyan LLM Configuration Template
# Copy this file to .env and fill in your credentials.
# Note: files matching .env* are ignored by git (except .env.example).

# Enable or disable LLM-assisted analysis (0 = off, 1 = on)
LLM_ENABLED=1

# Base URL for OpenAI-compatible endpoint (OpenAI, Anthropic proxy, Ollama, vLLM, etc.)
LLM_BASE_URL=https://api.openai.com/v1

# API Key for the endpoint
LLM_API_KEY=your-api-key-here

# Model name for advisory analysis and semantic inference
LLM_ANALYZE_MODEL=gpt-4o

# Model name for structured build/fix proposal generation
LLM_BUILD_MODEL=gpt-4o

# Maximum token budget for model responses (default: 4000)
LLM_MAX_TOKENS=4000

# Request timeout in seconds (default: 120)
LLM_TIMEOUT_SEC=120

# Disable TLS verification for local/self-signed endpoints (0 = verify, 1 = insecure)
# LLM_INSECURE_TLS=0
